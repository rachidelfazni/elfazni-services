# ========================================================
# ELFAZNI SERVICES — Environment Configuration Template
# ========================================================
# Copy this file to .env and configure values for your environment.
# Note: .env is ignored by Git and must never be committed.

# Node environment: 'production' for live deployments, 'development' for local Vite dev
NODE_ENV=production

# Server HTTP Port (default: 8080)
PORT=8080

# Host binding: 0.0.0.0 to listen on all network interfaces
HOST=0.0.0.0

# Base URL of the public application (used for robots.txt & sitemap.xml)
BASE_URL=https://elfazni.com

# Cryptographic secret for signing JWT auth tokens.
# REQUIRED: Must be a high-entropy string of at least 32 bytes in production.
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_bytes_long

# Default initial administrator password (used during seed/reset)
ADMIN_PASSWORD=ReplaceWithStrongPassword2026!

# SMTP Mail Server Configuration (Optional for production email alerts)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=notifications@elfazni.com
# SMTP_PASS=your-secure-app-password
# SMTP_FROM="ELFAZNI SERVICES <notifications@elfazni.com>"
